{
  "name": "@tekmerion/chainlink-appeals",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*/*.test.mjs && bun test tests/integrations/cre.test.ts",
    "build:wasm": "bun node_modules/@chainlink/cre-sdk/bin/cre-compile.ts src/main.ts ../../target/chainlink-appeals.wasm",
    "test:wasm": "npm run build:wasm && bun test tests/wasm/runtime.test.ts"
  },
  "dependencies": {
    "@chainlink/cre-sdk": "1.23.0",
    "@noble/hashes": "1.8.0",
    "@tekmerion/chainlink-sdk": "file:../../sdk/chainlink-typescript",
    "@tekmerion/sdk": "file:../../sdk/typescript",
    "core-js-pure": "3.51.0",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "2.6.3",
    "@types/node": "24.10.0",
    "typescript": "5.9.3"
  }
}
