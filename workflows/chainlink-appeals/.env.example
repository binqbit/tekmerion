# Required for live model calls; tests use recorded responses.
TEKMERION_MODEL_KEY=
# Optional; leave empty to run without publishing audit artifacts.
TEKMERION_ARCHIVE_KEY=

# Official CRE Solana simulator: dedicated, funded Devnet wallet only.
# Supply the 64-byte JSON keypair on one line or its base58 encoding.
CRE_SOLANA_PRIVATE_KEY=
CRE_SOLANA_RPC_URL=https://api.devnet.solana.com
