{
  "name": "@tekmerion/chainlink-sdk",
  "version": "1.0.0",
  "private": true,
  "description": "Chainlink auditor adapter client and portable report and account codecs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wire": {
      "types": "./dist/wire.d.ts",
      "import": "./dist/wire.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build",
    "format:check": "prettier --check \"src/**/*.ts\" tests/*.mjs package.json tsconfig.json README.md"
  },
  "peerDependencies": {
    "@tekmerion/sdk": "1.2.0",
    "@solana/web3.js": "1.99.0"
  },
  "devDependencies": {
    "@tekmerion/sdk": "file:../typescript",
    "@solana/web3.js": "1.99.0",
    "@anchor-lang/core": "1.2.1",
    "@types/node": "24.10.0",
    "typescript": "5.9.3",
    "prettier": "3.9.9"
  }
}
